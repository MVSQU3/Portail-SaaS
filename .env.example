# Postgres (Neon en production, Postgres local en développement).
# Aucune connexion n'est ouverte au build : si la variable est absente,
# `scripts/prisma-generate.mjs` utilise une URL factice uniquement pour
# générer le client Prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/fleetcare?schema=public"

# Auth.js / NextAuth v5. Générer une valeur longue pour tout environnement partagé :
# openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# URL publique de l'application (locale ou domaine Vercel).
AUTH_URL="http://localhost:3000"

# Jeton Vercel Blob. Requis seulement lors d'un upload (phase ultérieure).
# Le helper `uploadBlob` est branché ; aucun écran d'upload en phase 1.
BLOB_READ_WRITE_TOKEN=""

# E-mail transactionnel : phase 1 = journal stub (table EmailLog + log serveur).
# Aucun fournisseur SMTP n'est appelé, même si EMAIL_STUB=false.
EMAIL_FROM="noreply@fleetcare.local"
EMAIL_STUB="true"

# Paiement : constante de code, pas une variable d'environnement.
# src/lib/integrations.ts exporte PAY_KADEV_URL = https://pay.kadev.ci
# Aucune capture de paiement dans cette version.
